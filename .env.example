# ── Database ────────────────────────────────────────────────────────────────
# SQLite (default — zero setup)
DB_URL=sqlite:///./text2sql.db

# PostgreSQL (Docker Compose)
# DB_URL=postgresql://text2sql:text2sql@localhost:5432/text2sql
# POSTGRES_USER=text2sql
# POSTGRES_PASSWORD=text2sql

# ── LLM (Azure OpenAI) ──────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=

# Override model/deployment names (optional)
# FAST_MODEL=gpt-5.4-nano      # used for: query expansion, answer narration
# SQL_MODEL=gpt-5.3-chat       # used for: SQL generation + execution
# ANSWER_MODEL=gpt-5.4-nano
# EXPANSION_MODEL=gpt-5.4-nano
