# ── Database ────────────────────────────────────────────────────────────────
# SQLite (default — zero setup)
DB_URL=sqlite:///./text2sql.db

# PostgreSQL (Docker Compose)
# DB_URL=postgresql://text2sql:text2sql@localhost:5432/text2sql
# POSTGRES_USER=text2sql
# POSTGRES_PASSWORD=text2sql

# ── LLM (OpenAI-compatible Modal endpoints) ────────────────────────────────
# Combined Modal proxy token ID and secret, separated by a period.
MODAL_API_TOKEN=<proxy-token-id>.<proxy-token-secret>

# Required endpoint URLs, including /v1 (set these in your local .env)
FAST_MODEL_BASE_URL=
SQL_MODEL_BASE_URL=

# Optional model overrides
# FAST_MODEL=nvidia/GLM-5.3-Flash-NVFP4
# SQL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# ANSWER_MODEL=nvidia/GLM-5.3-Flash-NVFP4
# EXPANSION_MODEL=nvidia/GLM-5.3-Flash-NVFP4
# EVAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# REASONING_EFFORT=high
# MAX_TOKENS_SQL=2048
# MAX_TOKENS_ANSWER=2048
